{
  // Standalone Worker for PS2 multiplayer: WebRTC signaling (a Durable Object
  // per room) + a /turn endpoint that mints Cloudflare TURN credentials.
  // The Pages app (abhishekstation) talks to this over wss:// and https://.
  // Deploy: `npx wrangler deploy` from this directory.
  "name": "abhishekstation-mp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  // Per-IP rate limiting at the edge. Purpose-built binding rather than a
  // Durable Object counter: a single counter DO would serialise every request
  // through one instance and become the bottleneck an attacker aims at.
  // `period` may only be 10 or 60.
  "unsafe": {
    "bindings": [
      { "name": "RL_TURN", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
      { "name": "RL_CONN", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
      { "name": "RL_LOG",  "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 4,  "period": 60 } },
      { "name": "RL_READ", "type": "ratelimit", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SIGNAL_ROOM", "class_name": "SignalRoom" },
      { "name": "LOG_STORE", "class_name": "LogStore" },
      { "name": "WATCH_ROOM", "class_name": "WatchRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  // sqlite-backed classes so they run on the free Workers plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LogStore"] },
    { "tag": "v3", "new_sqlite_classes": ["WatchRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["Directory"] }
  ]
}
