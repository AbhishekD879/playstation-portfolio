node_modules/
dist/
.DS_Store
*.log
.wrangler/
.playwright-cli/
# large 3D controller models — CC-BY deploy assets, served via Cloudflare, not
# tracked in git (too big to push). See public/models/README.md to re-fetch.
public/models/*.glb

# stray test screenshots at repo root (public/ pngs are fine)
/*.png
.dev.vars

# CC0 Ludo tabletop assets (Poly Haven) — deploy assets, not tracked in git.
# See public/ludo/README.md to re-fetch.
public/ludo/*.jpg
public/ludo/*.hdr

# CC0 photogrammetry chess set — see public/models/README.md
public/models/chess/
.chrome-profile/

# local mirror of the R2 bucket (big game binaries) — upload with scripts/r2-sync.mjs, never commit
/r2/

# Diagnostic emulator build. Local-only: it carries PC-sampling bindings and
# CLog enabled, neither of which belongs in a shipped core.
public/play-diag/

# A/B baseline core (no WebGL feedback change). Local-only.
public/play-oph/

# Engine speed variants, one CMake lever each, for measuring a flag against the
# shared core. Local-only: they exist to be compared and thrown away. When a
# lever wins it goes into the shared core (public/play-mt/, which IS tracked)
# and its variant directory stops existing. See docs/ps2-engine-variants.md.
public/play-prof/
public/play-fast/
public/play-ehx/
public/play-simd/
public/play-lto/

# Self-hosted game builds — not redistributed with this repo, supplied by the
# owner and deployed from their machine. See src/webgames.ts and
# docs/self-hosted-games.md.
public/hl2/
public/pepsiman/

# Self-hosted builds the owner supplies. openrct2 needs RollerCoaster Tycoon 2
# data that is not ours; luanti is free software with no upstream web build.
public/openrct2/
public/luanti/

# GTA: Vice City — reverse-engineered engine, but the game data is Rockstar's.
# Supply your own from a copy you own. See docs/self-hosted-games.md.
#
# The directory is excluded by its contents, not as a whole, because index.html is
# ours: a hand-written host page, not a build artifact, and the only file here that
# cannot be regenerated from upstream. git cannot re-include a file whose parent
# directory is excluded, hence `public/gtavc/*` rather than `public/gtavc/`.
#
# Everything else stays out and must stay out: reVC.js and reVC.wasm are the
# Emscripten build, gamecontrollerdb.txt is SDL's, LICENSE-wasm-revc.md is upstream's,
# and any game data belongs to whoever owns the copy it came from.
public/gtavc/*
!public/gtavc/index.html
